// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Contact messages table
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  
}


// Admissions table
model Admission {
  id                String   @id @default(cuid())
  applicationId     String   @unique // ADM-2026-XXXX (auto-generated tracking ID)
  
  // Student Info
  studentFirstName  String
  studentLastName   String
  studentDOB        DateTime
  studentGender     String   // male, female, other
  previousSchool    String?
  
  // Parent/Guardian Info
  parentFirstName   String
  parentLastName    String
  parentEmail       String
  parentPhone       String
  parentOccupation  String?
  parentAddress     String?
  
  // Application Details
  applyingForClass  String   // Grade/Class applying for
  academicYear      String   // 2026/2027
  admissionType     String   // day, boarding
  
  // Documents (store URLs after upload)
  birthCertificate  String?
  previousReports   String?
  medicalReport     String?
  passportPhoto     String?
  
  // Application Status
  status            String   @default("draft") // draft, submitted, under-review, accepted, rejected, waitlisted
  currentStep       Int      @default(1) // Track which form step they're on (1-5)
  isComplete        Boolean  @default(false)
  
  // Tracking & Expiry
  lastSaved         DateTime @updatedAt
  draftExpiresAt    DateTime? // 7 days from first draft
  submittedAt       DateTime?
  reviewedAt        DateTime?
  
  // Admin Use
  reviewerNotes     String?  @db.Text
  adminId           String?  // If you have admin users later
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([applicationId])
  @@index([parentEmail])
  @@index([status])
  @@index([draftExpiresAt])
  @@index([createdAt])
}