// ──────────────────────────────────────────────
// The Benedictine Academy - Database Schema
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──

enum Term {
  FIRST
  SECOND
  THIRD
}

enum Grade {
  A // Distinction (90%+)
  B // Credit (70%+)
  C // Pass (50%+)
  F // Fail (Below 50%)
}

enum Rating {
  EXCELLENT // 5
  GOOD // 4
  AVERAGE // 3
  POOR // 2
  VERY_POOR // 1
}

enum Evaluation {
  EXCELLENT
  GOOD
  AVERAGE
  BELOW_AVERAGE
  POOR
}

enum Role {
  ADMIN
  TEACHER
}

enum StudentType {
  SCIENCE
  ART
  COMMERCIAL
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  AWAITING_TEST
  TEST_SCHEDULED
  TEST_COMPLETED
  INTERVIEW_SCHEDULED
  ACCEPTED
  REJECTED
  ADMITTED
}

// ── Models ──

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  password              String
  role                  Role
  assignedClass         String? // For TEACHER role only
  lastLoginAt           DateTime?
  lastLoginIp           String?
  loginAttempts         Int                    @default(0)
  lockedUntil           DateTime?
  admissionApplications AdmissionApplication[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([email])
}

model AcademicSession {
  id               String            @id @default(cuid())
  year             String
  term             Term
  isActive         Boolean           @default(false)
  results          Result[]
  socialBehaviours SocialBehaviour[]
  attendances      Attendance[]
  resultSummaries  ResultSummary[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([year, term])
  @@index([isActive])
}

model Student {
  id                    String            @id @default(cuid())
  studentId             String            @unique
  password              String
  firstName             String
  lastName              String
  class                 String
  studentType           StudentType? // SCIENCE, ART, COMMERCIAL — for SSS only
  guardianName          String?
  guardianPhone         String?
  passwordResetRequired Boolean           @default(true)
  results               Result[]
  passwordHistories     PasswordHistory[]
  socialBehaviours      SocialBehaviour[]
  attendances           Attendance[]
  resultSummaries       ResultSummary[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([studentId])
  @@index([class])
  @@index([firstName, lastName])
}

model Subject {
  id      String   @id @default(cuid())
  name    String
  level   String   @default("JSS") // JSS, SSS
  stream  String? // SCIENCE, ART, COMMERCIAL, ALL
  results Result[]

  @@unique([name, level, stream])
  @@index([level, stream])
}

model Result {
  id        String          @id @default(cuid())
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  subject   Subject         @relation(fields: [subjectId], references: [id])
  subjectId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  firstTest  Float?
  secondTest Float?
  exam       Float?
  total      Float?
  grade      Grade?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, sessionId])
  @@index([studentId, sessionId])
  @@index([subjectId])
}

model SocialBehaviour {
  id        String          @id @default(cuid())
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  obedience              Rating?
  honesty                Rating?
  responsibility         Rating?
  selfControl            Rating?
  leadership             Rating?
  relationshipWithOthers Rating?
  gamesAndSports         Rating?
  health                 Rating?
  neatness               Rating?
  manipulativeSkill      Rating?

  totalCumulative Float?
  totalScored     Float?
  percentageAvg   Float?
  remark          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, sessionId])
}

model Attendance {
  id        String          @id @default(cuid())
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  schoolOpened               Int?
  schoolPresent              Int?
  sportOpened                Int?
  sportPresent               Int?
  othersOpened               Int?
  othersPresent              Int?
  organizedActivitiesOpened  Int?
  organizedActivitiesPresent Int?

  remark String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, sessionId])
}

model ResultSummary {
  id        String          @id @default(cuid())
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  noInClass  Int?
  evaluation Evaluation?

  totalCumulative Float?
  totalScore      Float?
  percentageAvg   Float?
  remark          String?

  classTeacherComment String?
  nextTermFees        String?
  outstandingFees     String?
  books               String?
  nextTermBegins      String?
  headTeacherComment  String?
  parentName          String?
  parentSignature     String?
  date                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, sessionId])
}

model AdmissionApplication {
  id                 String            @id @default(cuid())
  registrationNumber String?           @unique
  status             ApplicationStatus @default(DRAFT)
  currentStep        Int               @default(1)

  // Personal Info
  surname       String
  firstName     String
  middleName    String?
  gender        String
  dateOfBirth   String
  placeOfBirth  String
  nationality   String  @default("Nigerian")
  stateOfOrigin String
  lga           String
  religion      String
  bloodGroup    String?
  genotype      String?

  // Parent Info
  fatherName         String
  motherName         String
  guardianName       String?
  occupation         String
  email              String
  phoneNumber        String
  alternatePhone     String?
  residentialAddress String
  emergencyContact   String
  emergencyPhone     String

  // Academic Info
  previousSchool String?
  previousClass  String?
  applyingClass  String
  session        String  @default("2026/2027")

  // Medical Info
  allergies            String?
  medicalConditions    String?
  specialNeeds         String?
  emergencyMedicalInfo String?

  // Documents
  birthCertificate     String?
  passportPhoto        String?
  previousResult       String?
  medicalReport        String?
  recommendationLetter String?

  // Payment
  paymentStatus    String  @default("PENDING")
  paymentReference String?
  paymentAmount    Float?

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Tracking
  submittedAt     DateTime?
  reviewedAt      DateTime?
  decisionAt      DateTime?
  admissionLetter String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([registrationNumber])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId    String
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([studentId])
}
